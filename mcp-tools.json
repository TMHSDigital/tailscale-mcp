  {
    "name": "ping_all",
    "title": "Ping all peers",
    "description": "Ping tailnet peers concurrently (bounded to 5 at a time, with a per-ping timeout) and return a latency matrix: node, latency ms of the settled path, path (direct, DERP relay, or peer relay), or unreachable. Defaults to online peers only. The whole call is capped at 45s; peers not answered by then are reported with an error and timedOut is true.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "count": {
          "description": "Ping attempts per peer (default: 1)",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeoutMs": {
          "description": "Per-ping timeout in milliseconds (default: 5000)",
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "onlineOnly": {
          "description": "Only ping peers reported online (default: true)",
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "pinged": {
          "type": "number"
        },
        "reachable": {
          "type": "number"
        },
        "timedOut": {
          "type": "boolean"
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hostname": {
                "type": "string"
              },
              "dnsName": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "reachable": {
                "type": "boolean"
              },
              "latencyMs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "direct",
                      "derp",
                      "peer-relay",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "via": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attempts": {
                "type": "number"
              },
              "replies": {
                "type": "number"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "hostname",
              "dnsName",
              "target",
              "reachable",
              "latencyMs",
              "path",
              "via",
              "attempts",
              "replies"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "pinged",
        "reachable",
        "timedOut",
        "matrix"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]
