{
  "name": "@tmhs/tailscale-mcp",
  "version": "0.4.0",
  "mcpName": "io.github.TMHSDigital/tailscale-mcp",
  "description": "MCP server for safe programmatic access to the local Tailscale daemon: tailnet discovery, SSH config generation, port sharing via Serve/Funnel, and latency matrices.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tailscale-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tools": "vitest run src/__tests__/tools-manifest.test.ts -u",
    "test:packed": "node scripts/smoke-packed.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "TMHSDigital",
  "license": "CC-BY-NC-ND-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/tailscale-mcp.git"
  },
  "homepage": "https://tmhsdigital.github.io/tailscale-mcp/",
  "bugs": {
    "url": "https://github.com/TMHSDigital/tailscale-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tailscale",
    "tailnet",
    "ssh",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
